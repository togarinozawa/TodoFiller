<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 端末内アラームでアプリを閉じていても通知する。Play非配布なのでUSE_EXACT_ALARMで自動許可。 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- オンライン更新：ダウンロードしたAPKをインストールするために必要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 準備画面の「電池の最適化から外す」。毎朝の組み直しと通知が止まる機種があるため -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 端末のカレンダーを直接読み書きする。
         Googleカレンダーアプリが同期した内容にそのまま触れるので、
         OAuthもサーバーも要らない（＝Googleの審査も不要）。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- ドパチル(com.dopachiru)へ学習予定を渡すための署名レベル権限。
         同じ鍵で署名されたアプリしか名乗れない。ドパチル未導入なら単に付与されないだけ。 -->
    <uses-permission android:name="com.dopachiru.permission.SYNC_STUDY" />

    <!-- 逆方向：ドパチルの「この予定を中断する」を受けるための権限。
         同じ鍵で署名されたアプリしか送れない（勝手に予定を消されないため）。 -->
    <permission
        android:name="dev.togar.dynasched.permission.CONTROL_SESSION"
        android:protectionLevel="signature" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dynasched">

        <!-- singleTop: ウィジェットの「暇」で開き直したとき、作り直さず onNewIntent で受ける -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddTaskActivity"
            android:exported="false"
            android:label="タスクを追加" />

        <!-- 使い方の説明。初回起動で一度出し、以降は設定から開く -->
        <activity
            android:name=".ui.HelpActivity"
            android:exported="false"
            android:label="使い方" />

        <!-- はじめる前の準備。初回は使い方の次に出し、以降は設定から開く -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:label="はじめる前の準備" />

        <!-- 更新APKを他アプリ（インストーラ）に安全に渡すためのFileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- アラーム発火時に通知を出すレシーバ -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!-- 再起動後にアラームを再登録するレシーバ -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- フィードバック通知のアクションボタン（完了/進捗）を処理するレシーバ -->
        <receiver
            android:name=".notify.NotifyActionReceiver"
            android:exported="false" />

        <!-- 毎朝5時に予定を組み直す。サーバー版のcronに相当する（端末内方式で必須） -->
        <receiver
            android:name=".notify.DailyRunReceiver"
            android:exported="false" />

        <!-- 就寝時刻に「今日はここまで」を出す -->
        <receiver
            android:name=".notify.BedtimeReceiver"
            android:exported="false" />

        <!-- ドパチルからの「この予定を中断する」を受けるレシーバ（署名一致必須） -->
        <receiver
            android:name=".integration.AbortSessionReceiver"
            android:exported="true"
            android:permission="dev.togar.dynasched.permission.CONTROL_SESSION">
            <intent-filter>
                <action android:name="dev.togar.dynasched.action.ABORT_SESSION" />
            </intent-filter>
        </receiver>

        <!-- ホーム画面ウィジェット：空き時間のタスク提案 -->
        <receiver
            android:name=".widget.SuggestWidgetProvider"
            android:exported="true"
            android:label="タスク提案">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_suggest_info" />
        </receiver>

    </application>
</manifest>
