<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_bg"
            android:ellipsize="end"
            android:id="@+id/rangeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="カレンダー"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:id="@+id/prevButton"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:id="@+id/todayButton"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:id="@+id/nextButton"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:id="@+id/modeButton"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="縦に"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:id="@+id/progressLine"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <Button
            android:textSize="13sp"
            android:textColor="@color/white"
            android:id="@+id/autoPlaceButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="自動で置く"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"/>
        <Button
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:id="@+id/freeTimeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暇なとき"
            android:layout_marginStart="8dp"
            style="?attr/materialButtonOutlinedStyle"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/on_bg_dim"
        android:id="@+id/hintText"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="長押しして引くと枠（作業できる時間）を作れます。予定は長押しで動かす・下端を引いて長さを変える。下のタスクは長押しして運べます。"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/taskTray"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </HorizontalScrollView>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/on_bg_dim"
        android:id="@+id/trayEmptyText"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="置けるタスクがありません"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <ScrollView
        android:id="@+id/gridScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:layout_weight="1">
        <dev.togar.dynasched.ui.TimeGridView
            android:id="@+id/timeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
