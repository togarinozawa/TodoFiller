<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="タスク"
            android:textColor="@color/on_bg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 並び順と表示の切替。押すとその場でメニューが出る -->
        <Button
            android:id="@+id/sortButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="並び順"
            android:textColor="@color/primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 検索。名前とメモの部分一致。グループの名前に当たれば配下ぜんぶ -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:hint="🔍 名前・メモで探す"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/on_bg"
        android:textColorHint="@color/on_bg_dim"
        android:textSize="14sp" />

    <!-- 条件チップ。種類をまたいで掛け合わせる（場所 × 優先度 × タグ …）。
         中身はコードで作る（タグや場所は増減するので） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- 配置の対象を絞っている間だけ出す。気付かないまま「置かれないタスクがある」と思わないように -->
    <TextView
        android:id="@+id/placeFilterText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:background="@color/surface_variant"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="@color/on_bg"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- いまやること。候補を1つだけ出して「これをやる」と言い切る -->
    <LinearLayout
        android:id="@+id/nowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/on_bg_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/nowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text=""
            android:textColor="@color/on_bg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/nowNext"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ほかの"
                android:textColor="@color/on_bg_dim" />

            <Button
                android:id="@+id/nowDo"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="やる"
                android:textColor="@color/primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 片付いた数・増えた数。設定で消せる -->
    <TextView
        android:id="@+id/statsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:text=""
        android:textColor="@color/on_bg_dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- タスク追加（専用画面へ遷移） -->
    <Button
        android:id="@+id/addTaskButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/primary"
        android:text="＋ タスクを追加"
        android:textColor="@color/white" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="タスクはありません"
                android:textColor="@color/on_bg_dim"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- 片付けた時に一瞬出す「+2 オヤスギ」。上へ浮いて消える -->
            <TextView
                android:id="@+id/pointPop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@color/surface"
                android:elevation="10dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text=""
                android:textColor="@color/accent_goal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 掴んでいる間だけ出す「いま何段目か」の表示。
                 **リストの上に重ねる。** 帯として差し込むとリストの高さが変わり、
                 掴んだ瞬間に一覧全体が跳ねてカクつく。 -->
            <TextView
                android:id="@+id/dragHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@color/surface"
                android:elevation="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text=""
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
