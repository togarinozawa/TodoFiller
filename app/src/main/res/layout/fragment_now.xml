<?xml version="1.0" encoding="utf-8"?>
<!-- いまやること。いまの場所と空き時間でできるものを1つ言い切る。下に次の候補 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="いまやること"
            android:textColor="@color/on_bg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 場所と時間。押すと変えられる（場所はその日いっぱい、時間はこの画面にいる間だけ） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/nowPlace"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text=""
                android:textColor="@color/primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/nowTime"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text=""
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nowPlaceFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/on_bg_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/nowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <!-- 分けた子タスクは名前だけだと何の話か分からないので、親を上に小さく出す -->
            <TextView
                android:id="@+id/nowParent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/on_bg_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text=""
                android:textColor="@color/on_bg"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nowMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text=""
                android:textColor="@color/on_bg_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/nowButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/nowNext"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ほかの"
                    android:textColor="@color/on_bg_dim" />

                <Button
                    android:id="@+id/nowDetail"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="詳しく"
                    android:textColor="@color/on_bg_dim" />

                <Button
                    android:id="@+id/nowDo"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="やる"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/nowOthersTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ほかの候補"
            android:textColor="@color/on_bg_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/nowOthers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/surface"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
