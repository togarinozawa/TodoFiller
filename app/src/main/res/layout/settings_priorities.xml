<?xml version="1.0" encoding="utf-8"?>
<!-- 優先度の段。上ほど先にやる。名前と目安を自由に決められる -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="上の段ほど先にやります。名前と目安（例:「すぐやれ」「暇ならやれ」）は、タスクで優先度を選ぶ時に出ます。押すと直せます。"
        android:textColor="@color/on_bg_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/levelList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/surface"
        android:orientation="vertical" />

    <Button
        android:id="@+id/addLevelButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/primary"
        android:text="段を足す"
        android:textColor="@color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="段を消すと、その段のタスクは選んだ段へ移ります。教材の優先度（低・中・高）は別で、ここでは変わりません。"
        android:textColor="@color/on_bg_dim"
        android:textSize="11sp" />

</LinearLayout>
